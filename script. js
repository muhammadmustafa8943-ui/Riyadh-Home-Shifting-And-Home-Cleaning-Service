function toggleLanguage() {
    const button = document.querySelector(".language-btn");

    const isArabic = document.body.classList.toggle("arabic");

    if (isArabic) {
        document.documentElement.dir = "rtl";
        document.documentElement.lang = "ar";
        button.textContent = "English";

        document.querySelector(".topbar").innerHTML =
            "📍 نخدم مدينة الرياض، المملكة العربية السعودية &nbsp;&nbsp; 📞 055 949 1031";

        document.querySelector(".hero h1").innerHTML =
            "انقل منزلك<br><span>بكل ثقة.</span>";

        document.querySelector(".hero p").textContent =
            "خدمات احترافية لنقل المنازل والتغليف ونقل الأثاث وتنظيف المنازل في جميع أنحاء الرياض.";

        document.querySelector(".hero .primary-btn").textContent =
            "احصل على عرض سعر مجاني →";

        document.querySelector(".hero .whatsapp-btn").textContent =
            "💬 تواصل معنا عبر واتساب";

        const headings = document.querySelectorAll("section h2");

        headings.forEach((heading) => {
            const text = heading.textContent.trim();

            if (text === "Our Services") {
                heading.textContent = "خدماتنا";
            }

            if (text === "Packages") {
                heading.textContent = "الباقات";
            }

            if (text === "Why Choose Us") {
                heading.textContent = "لماذا تختارنا؟";
            }

            if (text === "Get Your Free Quote") {
                heading.textContent = "احصل على عرض سعر مجاني";
            }

            if (text === "Home Shifting Across Riyadh") {
                heading.textContent = "نقل المنازل في جميع أنحاء الرياض";
            }

            if (text === "Contact Us") {
                heading.textContent = "تواصل معنا";
            }
        });

    } else {
        location.reload();
    }
}

function sendWhatsApp() {
    const name = document.getElementById("name").value;
    const phone = document.getElementById("phone").value;
    const pickup = document.getElementById("pickup").value;
    const destination = document.getElementById("destination").value;
    const service = document.getElementById("service").value;
    const property = document.getElementById("property").value;
    const date = document.getElementById("date").value;
    const time = document.getElementById("time").value;
    const details = document.getElementById("details").value;

    const message =
        "NEW SERVICE REQUEST" +
        "\n\n" +
        "Riyadh Home Shifting & Home Cleaning Company" +
        "\n\n" +
        "Name: " + name +
        "\nPhone: " + phone +
        "\nPickup: " + pickup +
        "\nDestination: " + destination +
        "\nService: " + service +
        "\nProperty: " + property +
        "\nDate: " + date +
        "\nTime: " + time +
        "\nDetails: " + details;

    const whatsappURL =
        "https://wa.me/966559491031?text=" +
        encodeURIComponent(message);

    window.open(whatsappURL, "_blank");
}

const dateInput = document.getElementById("date");

if (dateInput) {
    const today = new Date().toISOString().split("T")[0];
    dateInput.min = today;
}